# Starknet RPC (mainnet for the real run, a testnet/devnet endpoint while iterating)
RPC_URL=

# STRK20 privacy pool + the ERC-20 being shielded. Do not guess these —
# confirm the current mainnet pool address and a supported token from
# https://strk20-by-example.org before running anything for real.
POOL_ADDRESS=
TOKEN_ADDRESS=

# Privacy SDK infra (see .agents/skills/strk20-privacy-sdk/references/sdk__getting-started.md)
PROVING_SERVICE_URL=
INDEXER_URL=

# Consumer agent — holds funds, shields them, pays the provider per session.
CONSUMER_ACCOUNT_ADDRESS=
CONSUMER_ACCOUNT_PRIVATE_KEY=
# Must be a decimal BigInt string in [1, MAX_VIEWING_KEY], NOT hex — a hex
# string compiles but silently derives the wrong channel keys.
CONSUMER_VIEWING_KEY=

# Provider agent — serves metered calls, receives private transfers.
PROVIDER_ACCOUNT_ADDRESS=
PROVIDER_ACCOUNT_PRIVATE_KEY=
PROVIDER_VIEWING_KEY=
