    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@strkret/privacy-client": "workspace:*",
    "starknet": "10.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
