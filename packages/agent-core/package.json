{
  "name": "@strkret/agent-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./voucher": {
      "types": "./dist/voucher.d.ts",
      "default": "./dist/voucher.js"
    },
    "./anonymizer": {
      "types": "./dist/anonymizer.d.ts",
